<?xml version="1.0" encoding="utf-8"?>
<!-- ui.GlassMenu: a compact glass card of options, which GlassMenu places just above the button that opened it.
     Its rows never grow with focus, so the scroller can clip to its own edges without cutting anything off. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/menuCard"
        android:layout_width="@dimen/menu_width"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_menu_surface"
        android:orientation="vertical"
        android:padding="@dimen/space_2xs">

        <ScrollView
            android:id="@+id/menuScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menuRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</merge>
