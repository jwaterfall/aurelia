<?xml version="1.0" encoding="utf-8"?>
<!-- A library page (Movies, TV Shows; LibraryPage): sort and filter buttons, with the name and facts of whichever
     poster has focus at the bar's far end, then every poster on the launcher's columns. The buttons sit over the
     top of the grid, below Home's top bar, in room the grid leaves above its first row (ui.PageTop), and scroll
     away with the posters as the bar does. While the first page loads, placeholder posters (and the count's)
     stand in their places. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/libraryContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <app.aurelia.tv.ui.PageGrid
            android:id="@+id/libraryGrid"
            style="@style/Widget.Launcher.Shelf"
            android:layout_height="match_parent"
            android:fadingEdgeLength="@dimen/page_fade"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_3xl"
            android:requiresFadingEdge="vertical" />

        <!-- Instead of the posters (signed out, unreachable, nothing matching): the shared empty state, in the
             middle of the page, a little above centre. -->
        <include
            android:id="@+id/libraryMessage"
            layout="@layout/view_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/space_3xl"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/libraryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/librarySort"
            style="@style/Widget.Launcher.Chip.Icon"
            android:drawableStart="@drawable/ic_sort" />

        <TextView
            android:id="@+id/libraryFilter"
            style="@style/Widget.Launcher.Chip.Icon"
            android:layout_marginStart="@dimen/control_gap"
            android:drawableStart="@drawable/ic_filter" />

        <TextView
            android:id="@+id/libraryGenre"
            style="@style/Widget.Launcher.Chip.Icon"
            android:layout_marginStart="@dimen/control_gap"
            android:drawableStart="@drawable/ic_genre" />

        <!-- While a filter is on: one press back to everything. -->
        <TextView
            android:id="@+id/libraryClear"
            style="@style/Widget.Launcher.Chip"
            android:layout_marginStart="@dimen/control_gap"
            android:text="@string/filter_clear"
            android:visibility="gone" />

        <!-- What has focus: its name, then the facts. How many there are while nothing does. On the buttons' foot,
             not their middle, so the gap down to the posters is the same under it as under them. -->
        <TextView
            android:id="@+id/libraryFocusName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Heading" />

        <TextView
            android:id="@+id/libraryFocusFacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/space_sm"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Meta" />

        <!-- In the count's place until it is known, as the posters have theirs: as tall as its line of text. -->
        <app.aurelia.tv.ui.Placeholder
            android:id="@+id/libraryCountGhost"
            android:layout_width="80dp"
            android:layout_height="@dimen/placeholder_meta"
            android:layout_gravity="bottom"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
