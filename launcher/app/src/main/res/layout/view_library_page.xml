<?xml version="1.0" encoding="utf-8"?>
<!-- A library page (Movies, TV Shows; LibraryPage): sort and filter buttons, with the name and facts of whichever
     poster has focus at the bar's far end, then every poster on the launcher's columns, scrolling up under the
     bar and Home's scroll edge (ui.ScrollEdge, which MainActivity draws to the bar's foot). While the first page
     loads, placeholder posters stand in their places. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/libraryToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm">

        <TextView
            android:id="@+id/librarySort"
            style="@style/Widget.Launcher.TextButton.Icon"
            android:drawableStart="@drawable/ic_sort" />

        <TextView
            android:id="@+id/libraryFilter"
            style="@style/Widget.Launcher.TextButton.Icon"
            android:layout_marginStart="@dimen/control_gap"
            android:drawableStart="@drawable/ic_filter" />

        <TextView
            android:id="@+id/libraryGenre"
            style="@style/Widget.Launcher.TextButton.Icon"
            android:layout_marginStart="@dimen/control_gap"
            android:drawableStart="@drawable/ic_genre" />

        <!-- What has focus: its name, then the facts. How many there are while nothing does. -->
        <TextView
            android:id="@+id/libraryFocusName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Heading" />

        <TextView
            android:id="@+id/libraryFocusFacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Meta" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/libraryContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryGrid"
            style="@style/Widget.Launcher.Shelf"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_3xl" />

        <!-- Instead of the posters (signed out, unreachable, nothing matching): the shared empty state, in the
             middle of the page, a little above centre. -->
        <include
            android:id="@+id/libraryMessage"
            layout="@layout/view_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/space_3xl"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
