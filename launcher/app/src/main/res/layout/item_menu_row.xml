<?xml version="1.0" encoding="utf-8"?>
<!-- An option in a GlassMenu: one compact line, white with focus, with a tick on the chosen one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/menu_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_sm"
    android:paddingTop="2dp"
    android:paddingEnd="@dimen/space_xs"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Control"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.RowSubtitle"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/space_xs"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick"
        android:tint="@color/on_glass" />
</LinearLayout>
