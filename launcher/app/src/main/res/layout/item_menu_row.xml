<?xml version="1.0" encoding="utf-8"?>
<!-- An option in a GlassMenu: a pill that turns white with focus, with a tick on the chosen one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/control_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_md"
    android:paddingTop="@dimen/space_2xs"
    android:paddingEnd="@dimen/space_sm"
    android:paddingBottom="@dimen/space_2xs"
    android:stateListAnimator="@animator/row_lift">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Control" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.RowSubtitle"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="@dimen/space_xs"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick"
        android:tint="@color/on_glass" />
</LinearLayout>
