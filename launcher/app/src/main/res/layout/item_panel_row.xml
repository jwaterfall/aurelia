<?xml version="1.0" encoding="utf-8"?>
<!-- A choice in a panel: a title, and an optional line under it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Launcher.PanelRow">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Launcher.Label" />

    <TextView
        android:id="@+id/rowSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Launcher.Meta.OnGlass"
        android:visibility="gone" />
</LinearLayout>
