<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerActivity: the video, and over it the controls, shown on any key and hidden again while playing:
     at the top the show's logo (or its title) and the episode, with the clock; at the
     bottom the seek bar and one row of glass buttons under it, each option opening a menu above it, with the
     time and when it ends. A skip button or the next episode rises in the corner when there is something to skip to. A glass
     card replaces it all when something cannot be played. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/text_primary" />

    <FrameLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:clipChildren="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="top"
            android:background="@drawable/player_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim" />

        <!-- What is playing, and the clock and who is signed in. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin_top"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/playerLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/player_logo_height"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:maxWidth="@dimen/player_logo_width"
                    android:scaleType="fitStart"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Launcher.PanelTitle"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/playerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2xs"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Launcher.Body"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- The clock as on Home. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Launcher.Clock" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:format12Hour="EEE d MMM"
                    android:format24Hour="EEE d MMM"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Launcher.Caption"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg">

            <!-- The seek bar. It takes focus: Left and Right scrub, OK pauses. -->
            <FrameLayout
                android:id="@+id/playerTrack"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:clipChildren="false"
                android:focusable="true">

                <ProgressBar
                    android:id="@+id/playerSeek"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="center_vertical"
                    android:max="1000"
                    android:progressDrawable="@drawable/seek_bar" />

                <!-- Where playback is; grows while the bar has focus. -->
                <View
                    android:id="@+id/playerThumb"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/seek_thumb"
                    android:scaleX="0.6"
                    android:scaleY="0.6" />
            </FrameLayout>

            <!-- Under the bar, in three groups: playing; what to hear and read; the rest. The time and when it
                 ends on the far side. PlayerActivity hides buttons that do not apply; each option opens a menu
                 above it. -->
            <LinearLayout
                android:id="@+id/playerButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/buttonPlay"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_play_pause"
                    android:src="@drawable/ic_pause" />

                <ImageView
                    android:id="@+id/buttonRewind"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_rewind"
                    android:src="@drawable/ic_rewind" />

                <ImageView
                    android:id="@+id/buttonForward"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_forward"
                    android:src="@drawable/ic_forward" />

                <ImageView
                    android:id="@+id/buttonSubtitles"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:layout_marginStart="@dimen/player_group_gap"
                    android:contentDescription="@string/player_subtitles"
                    android:src="@drawable/ic_subtitles" />

                <ImageView
                    android:id="@+id/buttonAudio"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_audio"
                    android:src="@drawable/ic_audio" />

                <ImageView
                    android:id="@+id/buttonNext"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:layout_marginStart="@dimen/player_group_gap"
                    android:contentDescription="@string/player_next_episode"
                    android:src="@drawable/ic_skip_next"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/buttonChapters"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_chapters"
                    android:src="@drawable/ic_chapters"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/buttonSpeed"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_speed"
                    android:src="@drawable/ic_speed" />

                <ImageView
                    android:id="@+id/buttonQuality"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_quality"
                    android:src="@drawable/ic_quality" />

                <ImageView
                    android:id="@+id/buttonZoom"
                    style="@style/Widget.Launcher.PlayerIcon"
                    android:contentDescription="@string/player_zoom"
                    android:src="@drawable/ic_zoom" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/playerTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Launcher.Control"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/playerEnds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:fontFeatureSettings="tnum"
                    android:textAppearance="@style/TextAppearance.Launcher.Control"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Skip intro, recap or credits: rises in the corner while that part plays. -->
    <TextView
        android:id="@+id/playerSkip"
        style="@style/Widget.Launcher.PlayerButton"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_3xl"
        android:alpha="0"
        android:visibility="gone" />

    <!-- The next episode, counting down to playing it, over the credits. -->
    <LinearLayout
        android:id="@+id/playerUpNext"
        style="@style/Widget.Launcher.PanelRow"
        android:layout_width="360dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_3xl"
        android:alpha="0"
        android:visibility="gone">

        <TextView
            android:id="@+id/upNextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/player_next_episode"
            android:textAppearance="@style/TextAppearance.Launcher.Control" />

        <TextView
            android:id="@+id/upNextDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.RowSubtitle" />
    </LinearLayout>

    <com.gathin.tvhome.ui.GlassMenu
        android:id="@+id/playerMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/playerError"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/glass_card"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_offline"
            android:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/player_failed"
            android:textAppearance="@style/TextAppearance.Launcher.CardTitle" />

        <TextView
            android:id="@+id/playerErrorBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Launcher.Body" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/playerOpenApp"
                style="@style/Widget.Launcher.PlayerButton"
                android:text="@string/player_open_in_jellyfin" />

            <TextView
                android:id="@+id/playerClose"
                style="@style/Widget.Launcher.PlayerButton"
                android:layout_marginStart="@dimen/control_gap"
                android:text="@string/player_back" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
