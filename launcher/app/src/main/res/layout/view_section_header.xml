<?xml version="1.0" encoding="utf-8"?>
<!-- Section header: a title on the left margin, an optional caption on the right margin. Include it and set the
     texts through its include id: header.findViewById(R.id.sectionTitle). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/section_title_gap"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/screen_margin">

    <TextView
        android:id="@+id/sectionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Launcher.SectionTitle" />

    <TextView
        android:id="@+id/sectionCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Launcher.Caption" />
</LinearLayout>
