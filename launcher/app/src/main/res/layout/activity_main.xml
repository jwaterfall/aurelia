<?xml version="1.0" encoding="utf-8"?>
<!--
  Home. Back to front: wallpaper, the ambient wash of the focused item, a scrim, then the top bar over four pages
  (Home, Movies, TV Shows, Apps). Content sits between the screen_margin lines; the rows bleed past them so cards scroll off the
  screen edge. See values/styles.xml for the components.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backdrop_base">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper" />

    <app.aurelia.tv.ui.AmbientBackdrop
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/backdrop_scrim" />

    <!-- Behind the top bar once a page scrolls under it (ui.ScrollEdge). -->
    <include
        android:id="@+id/edgeBand"
        layout="@layout/view_scroll_edge_band" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/screen_margin_top">

        <!-- Top bar: profile, Settings and Search | tabs | clock -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!-- Profile: the signed-in user's picture (or initial), a person icon while signed out. A round glass
                     button like Settings; with focus its white shows as a ring around the picture. -->
                <FrameLayout
                    android:id="@+id/btnProfile"
                    style="@style/Widget.Launcher.GlassButton"
                    android:layout_width="@dimen/control_height"
                    android:contentDescription="@string/sign_in"
                    android:padding="3dp">

                    <FrameLayout
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/avatar">

                        <TextView
                            android:id="@+id/avatarInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textAppearance="@style/TextAppearance.Launcher.Heading" />

                        <ImageView
                            android:id="@+id/avatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no" />
                    </FrameLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnSettings"
                    style="@style/Widget.Launcher.GlassButton.Icon"
                    android:layout_marginStart="@dimen/control_gap"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings" />

                <ImageView
                    android:id="@+id/btnSearch"
                    style="@style/Widget.Launcher.GlassButton.Icon"
                    android:layout_marginStart="@dimen/control_gap"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search" />
            </LinearLayout>

            <app.aurelia.tv.ui.SegmentedControl
                android:id="@+id/tabs"
                style="@style/Widget.Launcher.TabBar"
                android:layout_width="wrap_content"
                android:layout_centerInParent="true">

                <TextView
                    style="@style/Widget.Launcher.Tab"
                    android:text="@string/tab_home" />

                <TextView
                    style="@style/Widget.Launcher.Tab"
                    android:text="@string/tab_movies" />

                <TextView
                    style="@style/Widget.Launcher.Tab"
                    android:text="@string/tab_shows" />

                <TextView
                    style="@style/Widget.Launcher.Tab"
                    android:text="@string/tab_apps" />
            </app.aurelia.tv.ui.SegmentedControl>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/clock_overhang"
                android:layout_marginBottom="@dimen/clock_overhang"
                android:gravity="end"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Launcher.Clock" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:format12Hour="EEE d MMM"
                    android:format24Hour="EEE d MMM"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.Launcher.Meta.Quiet" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The pages. Movies and TV Shows (LibraryPage) are added to these in code, between Home and Apps. -->
        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Home: Continue Watching, Next Up, then the pinned apps, resting low on the screen while they fit,
                 and otherwise scrolling just far enough to show the row with focus whole. -->
            <app.aurelia.tv.ui.SectionScrollView
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingTop="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_3xl">

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/cwSection"
                        style="@style/Widget.Launcher.HomeSection">

                        <include
                            android:id="@+id/cwHeader"
                            layout="@layout/view_section_header" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/cwRow"
                            style="@style/Widget.Launcher.Shelf"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nuSection"
                        style="@style/Widget.Launcher.HomeSection"
                        android:visibility="gone">

                        <include
                            android:id="@+id/nuHeader"
                            layout="@layout/view_section_header" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/nuRow"
                            style="@style/Widget.Launcher.Shelf"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/Widget.Launcher.HomeSection"
                        android:paddingBottom="0dp">

                        <include
                            android:id="@+id/pinnedHeader"
                            layout="@layout/view_section_header" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/pinnedRow"
                            style="@style/Widget.Launcher.Shelf"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </app.aurelia.tv.ui.SectionScrollView>

            <!-- Apps: every app, five to a row on the same columns as the Home row. Rows scroll up under the scroll
                 edge; the page clips them at the grid's own top, below the header. -->
            <LinearLayout
                android:id="@+id/pageApps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_xl" />

                <include
                    android:id="@+id/appsHeader"
                    layout="@layout/view_section_header" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appsGrid"
                    style="@style/Widget.Launcher.Shelf"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_3xl" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- The scroll edge's shadow, over the page under it. -->
    <include
        android:id="@+id/edgeShadow"
        layout="@layout/view_scroll_edge_shadow" />

    <!-- Menus of the library pages' sort and filter pills. -->
    <app.aurelia.tv.ui.GlassMenu
        android:id="@+id/menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Side panels (sign-in, account) open over everything else. -->
    <app.aurelia.tv.ui.GlassSheet
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
