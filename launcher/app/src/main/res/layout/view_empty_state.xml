<?xml version="1.0" encoding="utf-8"?>
<!-- What stands in for content that is not there (EmptyState): an icon, a title, a line about it and one button
     that does the obvious thing. No card behind it: the same on Home, where it fills a row's place, and on a
     library, centred in the page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="@dimen/empty_icon"
        android:layout_height="@dimen/empty_icon"
        android:importantForAccessibility="no"
        android:tint="@color/text_tertiary" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Launcher.Heading" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:gravity="center"
        android:maxWidth="@dimen/empty_width"
        android:textAppearance="@style/TextAppearance.Launcher.Body" />

    <TextView
        android:id="@+id/emptyAction"
        style="@style/Widget.Launcher.TextButton"
        android:layout_marginTop="@dimen/space_md" />
</LinearLayout>
