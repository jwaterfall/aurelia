<?xml version="1.0" encoding="utf-8"?>
<!-- A film's or show's page while it loads, in the shape of view_details_header.xml: the logo, the facts, a few
     lines about it, and the buttons. MovieActivity and ShowActivity fade it out as the page arrives. The lines'
     margins put each one where the middle of its line of text will be (Meta, then Body's 1.3 line height). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/details_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <app.aurelia.tv.ui.Placeholder
        android:id="@+id/placeholderMark"
        android:layout_width="240dp"
        android:layout_height="@dimen/details_logo_height"
        app:placeholderRadius="@dimen/radius_card" />

    <app.aurelia.tv.ui.Placeholder
        android:layout_width="200dp"
        android:layout_height="@dimen/placeholder_line"
        android:layout_marginTop="20dp" />

    <app.aurelia.tv.ui.Placeholder
        android:layout_width="match_parent"
        android:layout_height="@dimen/placeholder_line"
        android:layout_marginTop="21dp" />

    <app.aurelia.tv.ui.Placeholder
        android:layout_width="460dp"
        android:layout_height="@dimen/placeholder_line"
        android:layout_marginTop="13dp" />

    <app.aurelia.tv.ui.Placeholder
        android:id="@+id/placeholderLastLine"
        android:layout_width="300dp"
        android:layout_height="@dimen/placeholder_line"
        android:layout_marginTop="13dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <app.aurelia.tv.ui.Placeholder
            android:layout_width="112dp"
            android:layout_height="@dimen/control_height" />

        <app.aurelia.tv.ui.Placeholder
            android:layout_width="@dimen/control_height"
            android:layout_height="@dimen/control_height"
            android:layout_marginStart="@dimen/control_gap" />

        <app.aurelia.tv.ui.Placeholder
            android:layout_width="@dimen/control_height"
            android:layout_height="@dimen/control_height"
            android:layout_marginStart="@dimen/control_gap" />
    </LinearLayout>
</LinearLayout>
