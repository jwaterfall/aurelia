<?xml version="1.0" encoding="utf-8"?>
<!-- A poster's place while a library's first page loads (PosterAdapter). -->
<app.aurelia.tv.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="false"
    app:aspectRatio="0.6667">

    <app.aurelia.tv.ui.Placeholder
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderRadius="@dimen/radius_card" />
</app.aurelia.tv.ui.AspectRatioFrameLayout>
