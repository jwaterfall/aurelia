<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for a media row with nothing to show (signed out, unreachable, caught up): the shared empty state,
     centred in the row's place (the width of the row, the height of its cards). It does not take focus; its
     button does. ContinueWatchingAdapter sizes it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <include
        layout="@layout/view_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
