<?xml version="1.0" encoding="utf-8"?>
<!-- An episode in a show's row (EpisodeAdapter, which sets the width): its still, with a tick once watched and
     watch progress, and under it its number, name and length and a couple of lines about it. The whole item takes
     focus; the still shows it, as a card does, and the name brightens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:orientation="vertical">

    <app.aurelia.tv.ui.AspectRatioFrameLayout
        android:id="@+id/episodeCard"
        style="@style/Widget.Launcher.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false">

        <app.aurelia.tv.ui.Placeholder
            android:id="@+id/episodeLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:placeholderRadius="@dimen/radius_card" />

        <ImageView
            android:id="@+id/episodeStill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/episodeBadge"
            style="@style/Widget.Launcher.CardBadge"
            android:text="@string/watched_mark" />

        <ProgressBar
            android:id="@+id/episodeProgress"
            style="@style/Widget.Launcher.CardProgress" />
    </app.aurelia.tv.ui.AspectRatioFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:baselineAligned="true"
        android:duplicateParentState="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/episodeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Label"
            android:textColor="@color/text_on_focusable" />

        <TextView
            android:id="@+id/episodeLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Meta.Quiet" />
    </LinearLayout>

    <TextView
        android:id="@+id/episodeOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2xs"
        android:ellipsize="end"
        android:lines="2"
        android:textAppearance="@style/TextAppearance.Launcher.Body.Quiet" />
</LinearLayout>
