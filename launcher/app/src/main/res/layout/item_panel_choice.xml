<?xml version="1.0" encoding="utf-8"?>
<!-- One of several options in a panel (a subtitle language, a speed): a panel row with a tick on the chosen one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Launcher.PanelRow"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.Control" />

        <TextView
            android:id="@+id/rowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@style/TextAppearance.Launcher.RowSubtitle"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/rowCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_sm"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick"
        android:tint="@color/on_glass" />
</LinearLayout>
