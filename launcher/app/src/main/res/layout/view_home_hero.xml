<?xml version="1.0" encoding="utf-8"?>
<!-- Home's framed hero, stepping through what is in progress and next up. HomeHero fills it.
     Its padding puts it as far below the top bar's controls (screen_margin_top) as the controls are below the top
     of the screen, and the next section's heading the same distance below it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Launcher.HomeSection"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_sm"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <!-- No lift with focus: a card the width of the screen would grow past the margins. The ring is enough. -->
    <FrameLayout
        android:id="@+id/hero"
        style="@style/Widget.Launcher.Card"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height"
        android:stateListAnimator="@null">

        <ImageView
            android:id="@+id/heroArtBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/heroArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_scrim" />

        <LinearLayout
            android:id="@+id/heroInfo"
            android:layout_width="@dimen/hero_info_width"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2xl">

            <ImageView
                android:id="@+id/heroLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxWidth="@dimen/hero_logo_width"
                android:maxHeight="@dimen/hero_logo_height"
                android:scaleType="fitStart" />

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Launcher.Display" />

            <TextView
                android:id="@+id/heroMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Launcher.Label"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/heroOverview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.Launcher.Body" />

            <ProgressBar
                android:id="@+id/heroProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="@dimen/hero_progress_width"
                android:layout_height="@dimen/progress_height"
                android:layout_marginTop="@dimen/space_md"
                android:max="100"
                android:progressDrawable="@drawable/progress_bar" />

            <!-- What OK does on this slide: Resume or Play straight away, or More info on its page. Not a button
                 of its own: it takes the card's state, so it turns white while the card has focus. -->
            <TextView
                android:id="@+id/heroAction"
                style="@style/Widget.Launcher.TextButton.Icon"
                android:layout_marginTop="@dimen/space_md"
                android:clickable="false"
                android:duplicateParentState="true"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <app.aurelia.tv.ui.HeroDots
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_lg"
            android:background="@drawable/glass_track"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xs" />

        <!-- While the first slide is on its way: the whole card as one placeholder, as the rows' cards are. -->
        <app.aurelia.tv.ui.Placeholder
            android:id="@+id/heroSkeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:placeholderRadius="@dimen/radius_card" />
    </FrameLayout>
</LinearLayout>
