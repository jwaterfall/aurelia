<?xml version="1.0" encoding="utf-8"?>
<!-- A film's or show's poster in a library: its art (breathing while it loads; its name if there is none), a tick
     once watched or how many episodes are left, and watch progress. Width is set by PosterAdapter. -->
<app.aurelia.tv.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Launcher.Card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:aspectRatio="0.6667">

    <!-- While the art is on its way. -->
    <app.aurelia.tv.ui.Placeholder
        android:id="@+id/posterLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:placeholderRadius="@dimen/radius_card" />

    <TextView
        android:id="@+id/posterName"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="4"
        android:padding="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.Launcher.Label"
        android:textColor="@color/text_secondary"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/posterArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/posterBadge"
        style="@style/Widget.Launcher.CardBadge" />

    <ProgressBar
        android:id="@+id/posterProgress"
        style="@style/Widget.Launcher.CardProgress" />
</app.aurelia.tv.ui.AspectRatioFrameLayout>
