<?xml version="1.0" encoding="utf-8"?>
<!-- One step of a panel: a title, a few lines of explanation, an optional large code, and choices below.
     PanelStep fills it in; anything it does not use stays gone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- Header: the title and explanation, with an avatar to their left when the step is about a person. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/stepAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/space_md"
            android:background="@drawable/avatar"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Launcher.Title" />

            <TextView
                android:id="@+id/stepBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2xs"
                android:textAppearance="@style/TextAppearance.Launcher.Body" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/stepCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:includeFontPadding="false"
        android:textAppearance="@style/TextAppearance.Launcher.Code"
        android:visibility="gone" />

    <!-- Status: progress and errors, under the explanation. -->
    <LinearLayout
        android:id="@+id/stepStatusRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- While something is in progress; smaller than the line, so the line keeps its height without it. -->
        <ProgressBar
            android:id="@+id/stepSpinner"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="@dimen/space_xs"
            android:indeterminateTint="@color/text_tertiary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stepStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Launcher.Meta.Quiet" />
    </LinearLayout>

    <!-- The controls: a text field if the step has one, then the choices, all control_stack_gap apart. -->
    <LinearLayout
        android:id="@+id/stepRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:animateLayoutChanges="true"
        android:divider="@drawable/control_stack_gap"
        android:orientation="vertical"
        android:showDividers="middle">

        <EditText
            android:id="@+id/stepField"
            style="@style/Widget.Launcher.TextField"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
