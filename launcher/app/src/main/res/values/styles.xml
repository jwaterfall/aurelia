<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- ==== Launcher component library ================================================================
         Type, then widgets. Layouts use these styles rather than setting sizes, colours or fonts themselves;
         the values they use are the tokens in colors.xml and dimens.xml. -->

    <!-- Type -->
    <style name="TextAppearance.Launcher.SectionTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.Launcher.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
    <style name="TextAppearance.Launcher.Control" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textColor">@color/on_glass</item>
    </style>
    <style name="TextAppearance.Launcher.Overline" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Launcher.CardTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Launcher.Meta" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Launcher.Clock" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Glass button: the one control shape in the top bar and in empty rows. Pill with text, or a circle. -->
    <style name="Widget.Launcher.GlassButton" parent="">
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:background">@drawable/glass_button</item>
        <item name="android:stateListAnimator">@animator/control_lift</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Widget.Launcher.GlassButton.Icon">
        <item name="android:layout_width">@dimen/control_height</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/on_glass</item>
    </style>

    <!-- A text pill in the player (options under the seek bar, skip intro): a glass button sized to its label. -->
    <style name="Widget.Launcher.PlayerButton" parent="Widget.Launcher.GlassButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textAppearance">@style/TextAppearance.Launcher.Control</item>
    </style>

    <!-- Tab bar (ui.SegmentedControl) and its tabs. The control draws the indicator and colours the tab text. -->
    <style name="Widget.Launcher.TabBar" parent="">
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:background">@drawable/glass_track</item>
        <item name="android:padding">@dimen/control_inset</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="Widget.Launcher.Tab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">@dimen/tab_padding</item>
        <item name="android:paddingEnd">@dimen/tab_padding</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
    </style>

    <!-- Card: any focusable tile with artwork (app tiles, media cards). Its artwork is clipped to the rounded
         corners by ui.AspectRatioFrameLayout (android:clipToOutline only works from Android 12 in XML). -->
    <style name="Widget.Launcher.Card" parent="">
        <item name="android:background">@drawable/card_surface</item>
        <item name="android:foreground">@drawable/card_focus_ring</item>
        <item name="android:stateListAnimator">@animator/card_lift</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- A row of cards (horizontal) or a grid of them. Bleeds to the screen edges so cards scroll off the edge
         rather than being cut at the margin; the padding keeps the first and last card on the margin line. -->
    <style name="Widget.Launcher.Shelf" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:scrollbars">none</item>
        <item name="android:descendantFocusability">afterDescendants</item>
    </style>
    <!-- Panels (ui.GlassSheet) and what goes in them. -->
    <style name="TextAppearance.Launcher.PanelTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Launcher.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="TextAppearance.Launcher.Code" parent="">
        <item name="android:textSize">44sp</item>
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.22</item>
    </style>
    <style name="TextAppearance.Launcher.RowSubtitle" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">@color/on_glass_secondary</item>
    </style>

    <!-- A choice in a panel: full width, glass that turns white with focus. item_panel_row.xml uses it. -->
    <style name="Widget.Launcher.PanelRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_height</item>
        <item name="android:background">@drawable/glass_row</item>
        <item name="android:stateListAnimator">@animator/row_lift</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:paddingTop">@dimen/space_xs</item>
        <item name="android:paddingBottom">@dimen/space_xs</item>
    </style>

    <!-- Text entry in a panel: glass at rest, white while typing. -->
    <style name="Widget.Launcher.TextField" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/row_height</item>
        <item name="android:background">@drawable/glass_row</item>
        <item name="android:paddingStart">@dimen/space_lg</item>
        <item name="android:paddingEnd">@dimen/space_lg</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/outfit_medium</item>
        <item name="android:textColor">@color/on_glass</item>
        <item name="android:textColorHint">@color/on_glass_secondary</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
