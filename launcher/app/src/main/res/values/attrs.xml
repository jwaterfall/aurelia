<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="GlassDrawable">
        <!-- Corner radius; leave unset for a pill (half the height). -->
        <attr name="glassRadius" format="dimension" />
        <!-- true: turns solid white while its view has focus (buttons). false: a static surface (tracks, panels). -->
        <attr name="glassInteractive" format="boolean" />
        <!-- true: the dense, darker glass of a panel that holds text over anything (ui.GlassSheet). -->
        <attr name="glassPanel" format="boolean" />
    </declare-styleable>
    <declare-styleable name="AspectRatioFrameLayout">
        <!-- Width divided by height; the height follows the width. 16:9 by default. -->
        <attr name="aspectRatio" format="float" />
    </declare-styleable>
    <declare-styleable name="SegmentedControl">
        <!-- true: no glass under the indicator at rest, only a line under the current tab (Widget.Launcher.TabBar.Quiet). -->
        <attr name="quiet" format="boolean" />
    </declare-styleable>
    <declare-styleable name="Placeholder">
        <!-- Corner radius; leave unset for a pill (half the height), as for a line of text. -->
        <attr name="placeholderRadius" format="dimension" />
    </declare-styleable>
</resources>
