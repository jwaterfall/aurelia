<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens: colours. Everything on screen takes its colour from here, so the look changes in one place. -->
<resources>
    <!-- Text on glass and on the backdrop. -->
    <color name="text_primary">#FFFFFFFF</color>
    <color name="text_secondary">#B8FFFFFF</color>
    <color name="text_tertiary">#80FFFFFF</color>

    <!-- Focus is always solid white, with dark content on it. Nothing else on screen is solid white. -->
    <color name="focus">#FFFFFFFF</color>
    <color name="on_focus">#FF0B0D14</color>

    <!-- Frosted glass: a fill that is lighter at the top, and a rim that catches light along the top edge. -->
    <color name="glass_fill_top">#2EFFFFFF</color>
    <color name="glass_fill_bottom">#14FFFFFF</color>
    <color name="glass_rim_top">#5CFFFFFF</color>
    <color name="glass_rim_bottom">#12FFFFFF</color>
    <!-- Panel glass (GlassDrawable's glassPanel, the menus'): over the frosted screen, a little denser than Home's
         glass so its text reads. -->
    <color name="glass_panel_top">#33FFFFFF</color>
    <color name="glass_panel_bottom">#1AFFFFFF</color>

    <!-- The tab indicator while focus is elsewhere: glass, a step brighter than the track under it. -->
    <color name="glass_selected">#38FFFFFF</color>
    <!-- A toggle that is on (watched, a favourite): its glass a step brighter, as a chosen tab is. -->
    <color name="glass_chosen_top">#4DFFFFFF</color>
    <color name="glass_chosen_bottom">#2BFFFFFF</color>

    <!-- Card surfaces before their artwork arrives, and the hairline that keeps dark artwork off the backdrop. -->
    <color name="surface_card">#1AFFFFFF</color>
    <color name="card_hairline">#1FFFFFFF</color>
    <!-- Between the buttons of one glass pill (ui.PillGroup). -->
    <!-- Over the backdrop while the player opens. -->
    <color name="curtain_scrim">#99000000</color>
    <!-- Under glass subtitles' glass, so white text reads over a bright picture. -->
    <color name="subtitle_glass_tint">#8C101218</color>
    <color name="pill_hairline">#33FFFFFF</color>
    <!-- Inside the white focus ring, so the ring reads on white artwork too. -->
    <color name="focus_ring_inner">#59000000</color>

    <!-- A card's badge (episodes left, watched): dark glass over the artwork. -->
    <color name="badge_fill">#B30B0D14</color>

    <!-- Behind the screensaver's text, so it reads on a light picture too. -->
    <color name="dream_text_shadow">#80000000</color>

    <!-- Over a film's or show's backdrop once the rows below it scroll up. -->
    <color name="details_dim">#E605070D</color>

    <!-- Over the backdrop behind a person's page, deeper than a film's: it is only a setting for them. -->
    <color name="person_dim">#C705070D</color>

    <!-- Something still loading (ui.Placeholder) breathes between these. -->
    <color name="placeholder_low">#0DFFFFFF</color>
    <color name="placeholder_high">#21FFFFFF</color>

    <color name="backdrop_base">#FF05070D</color>
    <color name="avatar">#FF4F7BFF</color>
    <!-- The jellyfish's blue from the icon, a touch brighter, for the few things that ask for attention
         (an update waiting). -->
    <color name="accent">#FF78B4F0</color>
    <color name="progress_track">#40FFFFFF</color>
    <color name="progress_buffered">#66FFFFFF</color>
    <!-- Over a menu's frosted snapshot of the screen, enough to keep its text clear on bright art; and
         in its place where there is nothing to frost (over playing video). -->
    <color name="menu_frost_tint">#59101218</color>
    <color name="menu_solid">#E015181F</color>
    <color name="icon_ring">#4DFFFFFF</color>
    <!-- ui.ScrollEdge: the band behind the top bar once a page scrolls under it, and its shadow halfway out. -->
    <color name="scroll_edge">#D90B0D14</color>
    <color name="scroll_edge_mid">#730B0D14</color>
</resources>
