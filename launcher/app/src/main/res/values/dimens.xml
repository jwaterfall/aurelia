<?xml version="1.0" encoding="utf-8"?>
<!-- Design tokens: spacing, sizes and corner radii. One spacing scale for the whole launcher. -->
<resources>
    <dimen name="space_2xs">4dp</dimen>
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>
    <dimen name="space_2xl">40dp</dimen>
    <dimen name="space_3xl">48dp</dimen>

    <!-- Left and right edge of all content, on every page. -->
    <dimen name="screen_margin">48dp</dimen>
    <dimen name="screen_margin_top">28dp</dimen>
    <!-- Gap between tiles, the same across and down, wide enough that a focused tile never touches its neighbour. -->
    <dimen name="gutter">20dp</dimen>
    <!-- Between a section title and its row. -->
    <dimen name="section_title_gap">12dp</dimen>
    <!-- Between two sections on a page. -->
    <dimen name="section_gap">36dp</dimen>

    <!-- Everything in the top bar is this tall. -->
    <dimen name="control_height">40dp</dimen>
    <dimen name="control_inset">4dp</dimen>
    <dimen name="control_gap">12dp</dimen>
    <dimen name="tab_padding">22dp</dimen>

    <dimen name="radius_card">14dp</dimen>
    <!-- radius_card less the focus ring, for anything drawn just inside it. -->
    <dimen name="radius_card_inner">12dp</dimen>
    <!-- Panels share the cards' corners, so everything on screen is one family of shapes. -->
    <dimen name="radius_panel">@dimen/radius_card</dimen>
    <dimen name="focus_ring">2dp</dimen>
    <dimen name="hairline">1dp</dimen>
    <dimen name="progress_height">3dp</dimen>

    <!-- Side panel (ui.GlassSheet). -->
    <dimen name="panel_width">420dp</dimen>
    <dimen name="panel_padding">32dp</dimen>
    <dimen name="panel_margin">@dimen/space_lg</dimen>
    <dimen name="row_height">52dp</dimen>
    <!-- A GlassMenu over the player. -->
    <dimen name="menu_width">240dp</dimen>
    <dimen name="menu_row_height">32dp</dimen>
    <dimen name="menu_max_height">320dp</dimen>
    <dimen name="menu_row_radius">8dp</dimen>
    <!-- The rows' radius plus the card's padding, so the corners nest. -->
    <dimen name="menu_radius">12dp</dimen>
    <!-- The player: its round buttons, and the show's logo. -->
    <dimen name="player_button">38dp</dimen>
    <dimen name="player_logo_height">56dp</dimen>
    <dimen name="player_logo_width">360dp</dimen>
    <!-- Between stacked controls in a panel (rows, fields), whatever they are. -->
    <dimen name="control_stack_gap">@dimen/space_sm</dimen>

    <!-- Lift on focus: elevation of the shadow. The scale lives in res/animator. -->
    <dimen name="lift_card">14dp</dimen>
    <dimen name="lift_control">6dp</dimen>
</resources>
