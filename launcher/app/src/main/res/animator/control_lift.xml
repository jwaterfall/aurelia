<?xml version="1.0" encoding="utf-8"?>
<!-- Focus on a top-bar button: a smaller lift than a card's. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="90" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="90" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set android:interpolator="@android:interpolator/decelerate_cubic">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.08" android:duration="220" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.08" android:duration="220" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="@dimen/lift_control" android:duration="220" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set android:interpolator="@android:interpolator/decelerate_quad">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:duration="180" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:duration="180" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0" android:duration="180" android:valueType="floatType" />
        </set>
    </item>
</selector>
