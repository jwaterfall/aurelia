<?xml version="1.0" encoding="utf-8"?>
<!-- A menu over playing video (ui.GlassMenu): the panels' glass on a dark tint, so its choices read over any
     picture. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_video_tint" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <item>
        <com.gathin.tvhome.ui.GlassDrawable xmlns:app="http://schemas.android.com/apk/res-auto"
            app:glassPanel="true"
            app:glassRadius="@dimen/radius_card" />
    </item>
</layer-list>
