<?xml version="1.0" encoding="utf-8"?>
<!-- A GlassMenu's glass, over the frosted screen (or a dark fill over video) that GlassMenu puts behind it: a light
     tint so its text reads, then the panels' glass with its rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_frost_tint" />
            <corners android:radius="@dimen/menu_radius" />
        </shape>
    </item>
    <item>
        <app.aurelia.tv.ui.GlassDrawable xmlns:app="http://schemas.android.com/apk/res-auto"
            app:glassPanel="true"
            app:glassRadius="@dimen/menu_radius" />
    </item>
</layer-list>
