<?xml version="1.0" encoding="utf-8"?>
<!-- On a poster or a still: a small dark-glass pill with how many episodes are left, or a tick once it is all
     watched. Dark, not white, so it reads on any artwork without competing with focus (the only solid white). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/badge_fill" />
    <stroke android:width="@dimen/hairline" android:color="@color/card_hairline" />
    <corners android:radius="@dimen/poster_badge" />
</shape>
