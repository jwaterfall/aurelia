<?xml version="1.0" encoding="utf-8"?>
<!-- Over the screensaver's slides: just enough dark at the top for the clock and at the foot for the caption,
     leaving the picture clear between. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top" android:height="@dimen/dream_scrim_top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#9905070D"
                android:endColor="#0005070D" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="@dimen/dream_scrim_bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#E605070D"
                android:centerColor="#8005070D"
                android:endColor="#0005070D" />
        </shape>
    </item>
</layer-list>
