<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens the lower part of a media card so its text reads over any artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00000000"
        android:centerColor="#6605070D"
        android:centerY="0.5"
        android:endColor="#E605070D" />
</shape>
