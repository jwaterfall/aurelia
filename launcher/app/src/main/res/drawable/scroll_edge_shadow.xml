<?xml version="1.0" encoding="utf-8"?>
<!-- ui.ScrollEdge's shadow over the content under the edge: the band's own colour at the edge, so the cut there
     never shows, easing out over a long way rather than a short dark strip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/scroll_edge"
        android:centerColor="@color/scroll_edge_mid"
        android:centerY="0.3"
        android:endColor="#000B0D14" />
</shape>
