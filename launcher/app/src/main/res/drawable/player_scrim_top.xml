<?xml version="1.0" encoding="utf-8"?>
<!-- Over the top of the picture while the controls show, so the title and clock read over any frame: pure black at
     the top, letterboxing's black, easing out to clear. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6000000"
        android:centerColor="#73000000"
        android:centerY="0.45"
        android:endColor="#00000000" />
</shape>
