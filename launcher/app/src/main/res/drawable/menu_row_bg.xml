<?xml version="1.0" encoding="utf-8"?>
<!-- An option in a GlassMenu: clear at rest, white with focus. It never grows or lifts, so nothing about it can
     reach past the menu's edge and be cut off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="100"
    android:exitFadeDuration="100">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus" />
            <corners android:radius="@dimen/menu_row_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/menu_row_radius" />
        </shape>
    </item>
</selector>
