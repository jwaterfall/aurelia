<?xml version="1.0" encoding="utf-8"?>
<!-- A side panel over playing video (ui.GlassSheet.setOverVideo): the panel's glass on a dark tint, so it reads
     over any picture without a frosted snapshot behind it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_video_tint" />
            <corners android:radius="@dimen/radius_panel" />
        </shape>
    </item>
    <item android:drawable="@drawable/glass_panel_surface" />
</layer-list>
